      <xsd:annotation>
       <xsd:documentation>Reserved for internal use.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="creationType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Describes whether this Calculated Insight Object Definition was added was added by the customer. Valid values include: Custom.</xsd:documentation>
       <xsd:appinfo>Type: CalculatedInsightCreationType(enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
